# DarfinOS · i3 Notebook (720p)
set $mod Mod4
set $profile $HOME/.config/darfinos/i3-notebook
font pango:JetBrainsMono Nerd Font Mono 10
default_border pixel 2
default_floating_border pixel 2
gaps inner 8
gaps outer 2
smart_gaps on
floating_modifier $mod
focus_follows_mouse yes
mouse_warping none
show_marks no

exec_always --no-startup-id sh "$profile/session.sh" desktop-start
exec --no-startup-id sh "$profile/session.sh" start

# Launchers
bindsym $mod+Return exec --no-startup-id sh "$profile/session.sh" terminal
bindsym $mod+b exec --no-startup-id sh "$profile/session.sh" browser
bindsym $mod+e exec --no-startup-id sh "$profile/session.sh" notebook-files
bindsym $mod+d exec --no-startup-id sh "$profile/session.sh" apps
bindsym $mod+Tab exec --no-startup-id sh "$profile/session.sh" windows
bindsym $mod+F1 exec --no-startup-id sh "$profile/session.sh" shortcuts
bindsym $mod+F2 exec --no-startup-id sh "$profile/session.sh" display
bindsym $mod+F3 exec --no-startup-id sh "$profile/session.sh" audio
bindsym $mod+F4 exec --no-startup-id sh "$profile/session.sh" fastfetch-window
bindsym $mod+F5 exec --no-startup-id sh "$profile/session.sh" calendar
bindsym $mod+F6 exec --no-startup-id sh "$profile/session.sh" system
bindsym $mod+F7 exec --no-startup-id sh "$profile/session.sh" settings
for_window [class="^DarfinOSNotebookSettings$"] floating enable, move position center
for_window [class="(?i)^(Arandr|Lxappearance)$"] floating enable, move position center
for_window [class="^DarfinOSNotebookPopup$"] floating enable, border pixel 0
for_window [instance="^darfinos-(network|fastfetch)$"] floating enable, move position center
for_window [class="^(Pavucontrol|Nm-connection-editor)$"] floating enable, move position center
for_window [class="(?i)^blueman-manager$"] floating enable, resize set 72 ppt 72 ppt, move position center
bindsym $mod+Shift+p exec --no-startup-id sh "$profile/session.sh" wallpaper
bindsym $mod+Shift+Return exec --no-startup-id sh "$profile/session.sh" pocket
bindsym --release $mod+grave exec --no-startup-id sh "$profile/session.sh" pocket
for_window [instance="^darfinos-pocket$"] mark --add darfinos-pocket, floating enable, resize set 75 ppt 60 ppt, move position center, move scratchpad, scratchpad show

bindsym $mod+q kill
bindsym $mod+Shift+q kill
bindsym $mod+Shift+c exec --no-startup-id sh "$profile/session.sh" reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec --no-startup-id sh "$profile/session.sh" system
bindsym $mod+l exec --no-startup-id i3lock -c 171a1f
bindsym --release Print exec --no-startup-id sh "$profile/session.sh" screenshot gui
bindsym --release $mod+Shift+s exec --no-startup-id sh "$profile/session.sh" screenshot gui
bindsym --release Shift+Print exec --no-startup-id sh "$profile/session.sh" screenshot full -c
bindsym $mod+Shift+b exec --no-startup-id sh "$profile/session.sh" bar-toggle

bindsym XF86MonBrightnessUp exec --no-startup-id sh "$profile/session.sh" brightness-up
bindsym XF86MonBrightnessDown exec --no-startup-id sh "$profile/session.sh" brightness-down
bindsym XF86AudioRaiseVolume exec --no-startup-id sh "$profile/session.sh" volume-up
bindsym XF86AudioLowerVolume exec --no-startup-id sh "$profile/session.sh" volume-down
bindsym XF86AudioPlay exec --no-startup-id sh "$profile/session.sh" media play-pause
bindsym XF86AudioNext exec --no-startup-id sh "$profile/session.sh" media next
bindsym XF86AudioPrev exec --no-startup-id sh "$profile/session.sh" media previous
bindsym XF86AudioMute exec --no-startup-id sh "$profile/session.sh" volume-mute
bindsym XF86AudioMicMute exec --no-startup-id sh "$profile/session.sh" mic-mute
bindsym $mod+n exec --no-startup-id dunstctl history-pop
bindsym $mod+Shift+n exec --no-startup-id dunstctl set-paused toggle
bindsym $mod+Ctrl+n exec --no-startup-id dunstctl close-all

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right
bindsym $mod+h split h
bindsym $mod+v split v
bindsym $mod+w layout tabbed
bindsym $mod+s layout stacking
bindsym $mod+Ctrl+e layout toggle split
bindsym $mod+f fullscreen toggle
bindsym $mod+m exec --no-startup-id sh "$profile/session.sh" window-minimize
bindsym $mod+Shift+m exec --no-startup-id sh "$profile/session.sh" window-restore
bindsym $mod+Ctrl+m exec --no-startup-id sh "$profile/session.sh" window-maximize
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

bindsym $mod+r mode "resize"
mode "resize" {
    bindsym Left resize shrink width 10 px or 5 ppt
    bindsym Down resize grow height 10 px or 5 ppt
    bindsym Up resize shrink height 10 px or 5 ppt
    bindsym Right resize grow width 10 px or 5 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

set $ws1 "1"
set $ws2 "2: Web"
set $ws3 "3: Escrita"
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Ctrl+Tab workspace back_and_forth
bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Match tiled, floating and tabbed windows to the graphite/gold desktop.
# class                 border      background  text     indicator   child_border
client.focused          {{ .accent }} #252930 #f2f2f2 {{ .accent }} {{ .accent }}
client.focused_inactive #454a54 #252930 #c0c4cd #454a54 #454a54
client.unfocused        #30353d #20242b #9299a5 #30353d #30353d
client.urgent           #ff7b7b #ff7b7b #171a1f #ff7b7b #ff7b7b
client.background       #171a1f
bar {
    id notebook
    position top
    font pango:DejaVu Sans Bold 10
    padding 3px 5px
    mode invisible
    hidden_state hide
    modifier $mod
    strip_workspace_numbers yes
    status_command sh "$profile/session.sh" status
    colors {
        background #171a1f
        statusline #f2f2f2
        separator #535861
        focused_workspace {{ .accent }} {{ .accent }} #171a1f
        inactive_workspace #171a1f #252930 #e5e7eb
    }
}

# Managed by Preferências do i3 Notebook and kept across Workshop updates.
include "$HOME/.config/darfinos/i3-notebook/preferences.conf"
