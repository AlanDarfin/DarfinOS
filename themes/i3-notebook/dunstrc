# DarfinOS · notificações do i3 Notebook
[global]
    follow = keyboard
    origin = top-right
    offset = (12, 12)
    width = (245, 340)
    height = (0, 140)
    notification_limit = 3
    padding = 10
    horizontal_padding = 12
    separator_height = 2
    frame_width = 2
    frame_color = "{{ .accent }}"
    corner_radius = 8
    font = DejaVu Sans 11
    markup = strip
    format = "<b>%s</b>\n%b"
    word_wrap = yes
    max_icon_size = 32
    history_length = 25
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#171a1f"
    foreground = "#f2f2f2"
    frame_color = "#535861"
    timeout = 4

[urgency_normal]
    background = "#171a1f"
    foreground = "#f2f2f2"
    timeout = 6

[urgency_critical]
    background = "#252930"
    foreground = "#ffffff"
    frame_color = "#ff7b7b"
    timeout = 0
