/* DarfinOS Notebook · square, centered launcher */
* {
    font: "JetBrains Mono 11";
    panel: #252930;
    ink: #171a1f;
    text: #f2f2f2;
    muted: #c0c4cd;
    accent: {{ .accent }};
    background-color: transparent;
    text-color: @text;
}
window {
    location: center;
    width: 40%;
    border: 2px;
    border-color: @accent;
    background-color: @panel;
}
mainbox {
    padding: 12px;
    spacing: 7px;
    children: [inputbar, message, listview, mode-switcher];
}
inputbar {
    padding: 2px;
    spacing: 7px;
    children: [prompt, textbox-prompt-separator, entry];
}
prompt { text-color: @accent; }
textbox-prompt-separator {
    str: "›";
    expand: false;
    text-color: @accent;
}
entry { placeholder: "Buscar"; placeholder-color: @muted; }
listview {
    lines: 10;
    fixed-height: false;
    scrollbar: false;
    spacing: 2px;
}
element {
    padding: 3px 4px;
    spacing: 6px;
}
element-icon { size: 16px; }
element-text { text-color: inherit; }
element normal normal, element alternate normal { text-color: @text; }
element selected {
    background-color: @accent;
    text-color: @ink;
}
mode-switcher { spacing: 6px; }
button { padding: 3px 4px; text-color: @muted; }
button selected { background-color: @accent; text-color: @ink; }
