# DarfinOS Notebook · GTK 2 palette, no external theme engine required.
style "darfinos-notebook"
{
    bg[NORMAL] = "#20242b"
    bg[PRELIGHT] = "#39404b"
    bg[ACTIVE] = "#2c313a"
    bg[SELECTED] = "{{ .accent }}"
    bg[INSENSITIVE] = "#252930"
    fg[NORMAL] = "#f2f2f2"
    fg[PRELIGHT] = "#ffffff"
    fg[ACTIVE] = "#f2f2f2"
    fg[SELECTED] = "#171a1f"
    fg[INSENSITIVE] = "#a8adb7"
    base[NORMAL] = "#171a1f"
    base[PRELIGHT] = "#252930"
    base[ACTIVE] = "#252930"
    base[SELECTED] = "{{ .accent }}"
    base[INSENSITIVE] = "#252930"
    text[NORMAL] = "#f2f2f2"
    text[PRELIGHT] = "#ffffff"
    text[ACTIVE] = "#f2f2f2"
    text[SELECTED] = "#171a1f"
    text[INSENSITIVE] = "#a8adb7"
}
class "GtkWidget" style "darfinos-notebook"
