{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/logo.png",
        "type": "chafa",
        "height": 20,
        "padding": {
            "top": 0,
            "right": 0
        }
    },
  "display": {
    "separator": " ➜  ",
    "color": {
      "keys": "#806f00"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "    \u001b[90m    󰌽   {user-name} • Fastfetch\u001b[90m  󰌽",
      "color": {
        "user": "#806f00",
        "host": "#806f00"
        }
    },
    {
      "type": "custom",
      "format": " 󰝤───────────────────────────────────────󰝤",
      "color": "#806f00"
    },
    {
      "type": "os",
      "key": " 󰣇  SYSTEM  ",
      "keyColor": "#ffcb2e"
    },
    {
      "type": "kernel",
      "key": " 󰌢  KERNEL  ",
      "keyColor": "#ffcb2e"
    },
    {
  "type": "command",
  "key": " 󰃭  AGE     ",
  "keyColor": "#ffcb2e",
  "text": "birth_install=$(stat -c %W /); if [ \"$birth_install\" -eq 0 ]; then birth_install=$(stat -c %Y /); fi; now=$(date +%s); echo $(((now-birth_install)/86400)) days"
    },
    {
      "type": "uptime",
      "key": " 󰔛  UPTIME  ",
      "keyColor": "#ffcb2e"
    },
    {
      "type": "packages",
      "key": " 󰏖  PACKS   ",
      "keyColor": "#ffcb2e"
    },
    {
      "type": "break"
    },
    {
      "type": "cpu",
      "key": " 󰍛  CPU     ",
      "keyColor": "#ffcb2e",
      "format": "{1}",
    },
    {
      "type": "gpu",
      "key": " 󰍹  GPU     ",
      "keyColor": "#ffcb2e",
      "format": "{2}"
    },
{
      "type": "memory",
      "key": " 󰑭  RAM     ",
      "keyColor": "#ffcb2e",
      "format": "{1} / {2} ({3})"
    },
    {
      "type": "disk",
      "key": " 󰋊  DISK    ",
      "keyColor": "#ffcb2e",
      "format": "{1} / {2} ({3})"
    },
    {
      "type": "break"
    },
    {
      "type": "wm",
      "key": " 󱂬  WINDOW  ",
      "keyColor": "#ffcb2e"
    },
    {
      "type": "shell",
      "key": " 󰆍  SHELL   ",
      "keyColor": "#ffcb2e"
    },
    {
      "type": "terminal",
      "key": "   TERM    ",
      "keyColor": "#ffcb2e"
    },
    {
      "type": "media",
      "key": " 󰝚  PLAYER  ",
      "keyColor": "#ffcb2e",
    },
    {
      "type": "break"
    },
    {
      "type": "custom",
      "format": " 󰝤───────────────────────────────────────󰝤",
      "color": "#806f00"
    },
  ]
}
